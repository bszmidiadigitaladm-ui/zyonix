# See docs/ENV_VARS.md for details on where to obtain each value.

# --- Public (safe to expose in the browser bundle) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key (bot protection on signup/login). Leave blank
# to render no widget locally — Supabase only enforces it once CAPTCHA
# protection is enabled in the dashboard with the matching secret key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_ORG_ID=

# Video Studio module — Runway API (https://dev.runwayml.com)
RUNWAY_API_KEY=

# Email sending — Resend (https://resend.com). Used by Church Admin
# communications, event reminders, and the daily devotional reminder.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shared secret checked by /api/cron/* routes, e.g. Netlify Scheduled Functions
CRON_SECRET=

# Hotmart — active payment processor (checkout links live on the `plans`
# table, not here). Verifies the X-HOTMART-HOTTOK header on /api/hotmart/webhook.
HOTMART_HOTTOK=

# Optional: a Discord or Slack incoming-webhook URL. When set, unhandled server
# errors post a short alert there (rate-limited per route). Logs are written
# either way — see src/instrumentation.ts.
ERROR_ALERT_WEBHOOK_URL=
