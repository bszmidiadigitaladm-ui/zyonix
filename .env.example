# See docs/ENV_VARS.md for details on where to obtain each value.

# --- Public (safe to expose in the browser bundle) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_CHURCH_PRO=

OPENAI_API_KEY=
OPENAI_ORG_ID=

# Video Studio module — Runway API (https://dev.runwayml.com)
RUNWAY_API_KEY=

# Shared secret checked by /api/cron/* routes, e.g. Netlify Scheduled Functions
CRON_SECRET=
